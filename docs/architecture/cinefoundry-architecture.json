  "cards": [
    {
      "dot": "cyan",
      "title": "Engine",
      "items": [
        "runPipeline: preflight, then projects/.harness.lock, then every stage in order",
        "Each stage marked running, then done or failed with the reason; Ctrl-C and SIGTERM included",
        "reports/run.jsonl: one line per model call and decision, tagged with the runId"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "Compliance: Advertising Law wording scan plus an independent reviewer (ad); independent reviewer plus screenplay checks (narrative)",
        "Vision gate on Step3-VL: product hero still (ad), locked portraits and character identity (narrative); at most 2 regenerations, then best attempt reported",
        "Whisper large-v3-turbo checks every spoken line and retakes it",
        "Every cut carries the visible AI label and AIGC metadata"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent skills (metadata.category)",
      "items": [
        "Production 8: cinefoundry-ad-film, cinefoundry-short-video, cinefoundry-micro-drama, ad-brief-intake, brand-kit, ad-compliance-review, content-compliance, spark-model-scheduler",
        "Writing 5: creative-direction, ad-script-writing, series-development, screenwriting, short-video-scripting",
        "Picture 5: storyboard-design, cinematography-and-art-direction, character-and-continuity, spark-local-media-generation, shot-quality-gate",
        "Sound 2: dialogue-and-voice, sound-design-and-music",
        "Post 5: editing-and-versioning, final-cut-assembly, bilingual-subtitles, platform-packaging, delivery-qc",
        "Research 1: ad-reference-breakdown"
      ]
    },
    {
      "dot": "amber",

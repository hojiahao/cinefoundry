  "cards": [
    {
      "dot": "cyan",
      "title": "阶段顺序",
      "items": [
        "① 主图 → ② 分镜帧 → ③ 视频 → ④ 配乐，依次执行",
        "每次进入新阶段前先调用 /free，内存里同一时间只放一个扩散模型家族",
        "② 的三个参考图槽位都放产品主图，每一帧都以它为基准"
      ]
    },
    {
      "dot": "emerald",
      "title": "调用方式",
      "items": [
        "不用网页界面：上传图片 → /prompt 排队 → 轮询 /history → /view 下载",
        "仓库里的模板带 {{占位符}}，运行时填入实际值后提交",
        "生成的 png / mp4 里嵌着完整工作流，拖进 ComfyUI 画布即可查看"
      ]
    },
    {
      "dot": "slate",
      "title": "不经过 ComfyUI 的部分",
      "items": [
        "Nemotron 写文案（vLLM :8001）",
        "Step3-VL 质检（vLLM :8002）",
        "Qwen3-TTS 配音、ffmpeg 剪辑合成",
        "备用：wan22_ti2v_5b_*，仅在 --video-model wan22-5b 时使用"
      ]
    }
  ]
